<mxfile host="drawio" type="device"><diagram id="d1" name="Operation tree"><mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="738" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c43" value="&lt;b&gt;execution&lt;/b&gt; &lt;font color='#7D8998'&gt;wf-example · input payload, status, invocations&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#232F3E;fontSize=11;fontStyle=0;dashed=0;absoluteArcSize=1;arcSize=12;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="1660" height="546" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;wave-3&lt;/b&gt; &lt;font color='#7D8998'&gt;Map · aab323&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#8C4FFF;fontSize=10;fontStyle=0;dashed=0;arcSize=2;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="1134" y="192" width="260" height="418" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;wave-2&lt;/b&gt; &lt;font color='#7D8998'&gt;Map · 6512bd&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#8C4FFF;fontSize=10;fontStyle=0;dashed=0;arcSize=2;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="858" y="192" width="260" height="136" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;wave-1&lt;/b&gt; &lt;font color='#7D8998'&gt;Map · c9f0f8&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#8C4FFF;fontSize=10;fontStyle=0;dashed=0;arcSize=2;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="582" y="192" width="260" height="118" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;wave-0&lt;/b&gt; &lt;font color='#7D8998'&gt;Map · e4da3b&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#8C4FFF;fontSize=10;fontStyle=0;dashed=0;arcSize=2;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="306" y="192" width="260" height="118" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Durable execution state&lt;/b&gt; — the operation tree" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Each box is an operation in the checkpoint log. Nesting = ParentId. Id = hash of the parent's Id and the call's position, so the code must call operations in the same order on every replay." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;" vertex="1" parent="1"><mxGeometry x="20" y="34" width="1600" height="20" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;prelude&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#8C4FFF;" vertex="1" parent="1"><mxGeometry x="30" y="140" width="260" height="18" as="geometry"/></mxCell><mxCell id="c5" value="load &lt;font color='#7D8998'&gt;— read the workflow record&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=9;fontStyle=0;dashed=0;arcSize=6;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="162" width="260" height="22" as="geometry"/></mxCell><mxCell id="c6" value="mark-running &lt;font color='#7D8998'&gt;— header → running&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=9;fontStyle=0;dashed=0;arcSize=6;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="192" width="260" height="22" as="geometry"/></mxCell><mxCell id="c7" value="init-sessions &lt;font color='#7D8998'&gt;— assign a session id per step&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=9;fontStyle=0;dashed=0;arcSize=6;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="222" width="260" height="22" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;wave 0&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#8C4FFF;" vertex="1" parent="1"><mxGeometry x="306" y="140" width="260" height="18" as="geometry"/></mxCell><mxCell id="c9" value="cancel-check-0 &lt;font color='#7D8998'&gt;— cancel requested?&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=9;fontStyle=0;dashed=0;arcSize=6;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="306" y="162" width="260" height="22" as="geometry"/></mxCell><mxCell id="c10" value="fact-r1-start &lt;font color='#7D8998'&gt;— step → running&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=9;fontStyle=0;dashed=0;arcSize=6;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="314" y="222" width="244" height="22" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;agent turn&lt;/b&gt; fact · run 1 · work 0&lt;br&gt;&lt;font color='#7D8998'&gt;start → wait → checkpointed result:&lt;/font&gt; &lt;b&gt;done&lt;/b&gt;&lt;font color='#7D8998'&gt; · 196 B&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6F3;strokeColor=#01A88D;fontSize=10;fontStyle=0;dashed=0;arcSize=6;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="314" y="252" width="244" height="50" as="geometry"/></mxCell><mxCell id="c13" value="save-wave-0 &lt;font color='#7D8998'&gt;— save step states&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=9;fontStyle=0;dashed=0;arcSize=6;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="306" y="318" width="260" height="22" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;wave 1&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#8C4FFF;" vertex="1" parent="1"><mxGeometry x="582" y="140" width="260" height="18" as="geometry"/></mxCell><mxCell id="c15" value="cancel-check-1 &lt;font color='#7D8998'&gt;— cancel requested?&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=9;fontStyle=0;dashed=0;arcSize=6;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="582" y="162" width="260" height="22" as="geometry"/></mxCell><mxCell id="c16" value="headline-r1-start &lt;font color='#7D8998'&gt;— step → running&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=9;fontStyle=0;dashed=0;arcSize=6;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="590" y="222" width="244" height="22" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;agent turn&lt;/b&gt; headline · run 1 · work 0&lt;br&gt;&lt;font color='#7D8998'&gt;start → wait → checkpointed result:&lt;/font&gt; &lt;b&gt;blocked → fact&lt;/b&gt;&lt;font color='#7D8998'&gt; · 397 B&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6F3;strokeColor=#01A88D;fontSize=10;fontStyle=0;dashed=0;arcSize=6;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="590" y="252" width="244" height="50" as="geometry"/></mxCell><mxCell id="c19" value="save-wave-1 &lt;font color='#7D8998'&gt;— save step states&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=9;fontStyle=0;dashed=0;arcSize=6;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="582" y="318" width="260" height="22" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;wave 2&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#8C4FFF;" vertex="1" parent="1"><mxGeometry x="858" y="140" width="260" height="18" as="geometry"/></mxCell><mxCell id="c21" value="cancel-check-2 &lt;font color='#7D8998'&gt;— cancel requested?&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=9;fontStyle=0;dashed=0;arcSize=6;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="858" y="162" width="260" height="22" as="geometry"/></mxCell><mxCell id="c22" value="fact-r2-start &lt;font color='#7D8998'&gt;— step → running&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=9;fontStyle=0;dashed=0;arcSize=6;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="866" y="222" width="244" height="22" as="geometry"/></mxCell><mxCell id="c23" value="&lt;i&gt;↺ re-run requested by headline (blocked)&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#DD344C;" vertex="1" parent="1"><mxGeometry x="866" y="252" width="244" height="16" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;agent turn&lt;/b&gt; fact · run 2 · work 0&lt;br&gt;&lt;font color='#7D8998'&gt;start → wait → checkpointed result:&lt;/font&gt; &lt;b&gt;done&lt;/b&gt;&lt;font color='#7D8998'&gt; · 157 B&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6F3;strokeColor=#01A88D;fontSize=10;fontStyle=0;dashed=0;arcSize=6;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="866" y="270" width="244" height="50" as="geometry"/></mxCell><mxCell id="c26" value="save-wave-2 &lt;font color='#7D8998'&gt;— save step states&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=9;fontStyle=0;dashed=0;arcSize=6;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="858" y="336" width="260" height="22" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;wave 3&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#8C4FFF;" vertex="1" parent="1"><mxGeometry x="1134" y="140" width="260" height="18" as="geometry"/></mxCell><mxCell id="c28" value="cancel-check-3 &lt;font color='#7D8998'&gt;— cancel requested?&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=9;fontStyle=0;dashed=0;arcSize=6;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1134" y="162" width="260" height="22" as="geometry"/></mxCell><mxCell id="c29" value="headline-r2-start &lt;font color='#7D8998'&gt;— step → running&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=9;fontStyle=0;dashed=0;arcSize=6;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1142" y="222" width="244" height="22" as="geometry"/></mxCell><mxCell id="c30" value="&lt;i&gt;↺ re-run after fact was redone&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#DD344C;" vertex="1" parent="1"><mxGeometry x="1142" y="252" width="244" height="16" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;agent turn&lt;/b&gt; headline · run 2 · work 0&lt;br&gt;&lt;font color='#7D8998'&gt;start → wait → checkpointed result:&lt;/font&gt; &lt;b&gt;done&lt;/b&gt;&lt;font color='#7D8998'&gt; · 137 B&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6F3;strokeColor=#01A88D;fontSize=10;fontStyle=0;dashed=0;arcSize=6;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1142" y="270" width="244" height="50" as="geometry"/></mxCell><mxCell id="c32" value="headline-r2-reviewing1 &lt;font color='#7D8998'&gt;— step → reviewing&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=9;fontStyle=0;dashed=0;arcSize=6;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1142" y="328" width="244" height="22" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;agent turn&lt;/b&gt; headline · run 2 · review 1&lt;br&gt;&lt;font color='#7D8998'&gt;start → wait → checkpointed result:&lt;/font&gt; &lt;b&gt;needs_revision&lt;/b&gt;&lt;font color='#7D8998'&gt; · 421 B&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6F3;strokeColor=#01A88D;fontSize=10;fontStyle=0;dashed=0;arcSize=6;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1142" y="358" width="244" height="50" as="geometry"/></mxCell><mxCell id="c34" value="headline-r2-revising1 &lt;font color='#7D8998'&gt;— step → running (revision)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=9;fontStyle=0;dashed=0;arcSize=6;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1142" y="416" width="244" height="22" as="geometry"/></mxCell><mxCell id="c35" value="&lt;i&gt;↺ revision requested by the reviewer&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#DD344C;" vertex="1" parent="1"><mxGeometry x="1142" y="446" width="244" height="16" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;agent turn&lt;/b&gt; headline · run 2 · work 1&lt;br&gt;&lt;font color='#7D8998'&gt;start → wait → checkpointed result:&lt;/font&gt; &lt;b&gt;done&lt;/b&gt;&lt;font color='#7D8998'&gt; · 137 B&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6F3;strokeColor=#01A88D;fontSize=10;fontStyle=0;dashed=0;arcSize=6;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1142" y="464" width="244" height="50" as="geometry"/></mxCell><mxCell id="c37" value="headline-r2-reviewing2 &lt;font color='#7D8998'&gt;— step → reviewing&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=9;fontStyle=0;dashed=0;arcSize=6;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1142" y="522" width="244" height="22" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;agent turn&lt;/b&gt; headline · run 2 · review 2&lt;br&gt;&lt;font color='#7D8998'&gt;start → wait → checkpointed result:&lt;/font&gt; &lt;b&gt;done&lt;/b&gt;&lt;font color='#7D8998'&gt; · 191 B&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6F3;strokeColor=#01A88D;fontSize=10;fontStyle=0;dashed=0;arcSize=6;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1142" y="552" width="244" height="50" as="geometry"/></mxCell><mxCell id="c40" value="save-wave-3 &lt;font color='#7D8998'&gt;— save step states&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=9;fontStyle=0;dashed=0;arcSize=6;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1134" y="618" width="260" height="22" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;end&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#8C4FFF;" vertex="1" parent="1"><mxGeometry x="1410" y="140" width="260" height="18" as="geometry"/></mxCell><mxCell id="c42" value="finalize &lt;font color='#7D8998'&gt;— header → result&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=9;fontStyle=0;dashed=0;arcSize=6;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1410" y="162" width="260" height="22" as="geometry"/></mxCell><mxCell id="c44" value="Abstracted: a WaitForCallback with its submitter step and callback is one &lt;b&gt;agent turn&lt;/b&gt;; white boxes are orchestrator bookkeeping steps (their results are checkpointed too). Red notes mark operations that exist only because an earlier result asked for them — the tree is decided at run time, unlike a Step Functions state machine." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;" vertex="1" parent="1"><mxGeometry x="20" y="678" width="1600" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
