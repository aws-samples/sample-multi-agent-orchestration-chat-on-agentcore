<mxfile host="drawio" type="device"><diagram id="d1" name="Runtime session pinning"><mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Runtime session pinning&lt;/b&gt; — one conversation, two runtime sessions (AgentCore Runtime V2)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="User (browser)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3E;strokeColor=none;dashed=0;html=1;whiteSpace=nowrap;fontSize=11;aspect=fixed;shape=mxgraph.aws4.client;labelPosition=center;verticalLabelPosition=top;align=center;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="72" y="166" width="48" height="48" as="geometry"/></mxCell><mxCell id="c4" value="Trigger Lambda" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;whiteSpace=nowrap;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;labelPosition=center;verticalLabelPosition=top;align=center;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="72" y="396" width="48" height="48" as="geometry"/></mxCell><mxCell id="c5" value="Workflow Orchestrator&lt;br&gt;(steps, completion notice)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;whiteSpace=nowrap;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="72" y="516" width="48" height="48" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;AgentCore Runtime (V2)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#01A88D;fontSize=11;fontStyle=0;dashed=1;arcSize=6;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="90" width="520" height="620" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;microVM&lt;/b&gt; — runtime session &lt;b&gt;&amp;lt;id&amp;gt;u&lt;/b&gt;&lt;br&gt;pinned to the user's sub&lt;br&gt;kept warm for the next turn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#01A88D;fontSize=11;fontStyle=0;dashed=0;arcSize=6;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="440" y="145" width="330" height="90" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;microVM&lt;/b&gt; — runtime session &lt;b&gt;&amp;lt;id&amp;gt;m&lt;/b&gt;&lt;br&gt;pinned to the machine user&lt;br&gt;stops itself after every turn&lt;br&gt;(also when rejected or failed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#01A88D;fontSize=11;fontStyle=0;dashed=0;arcSize=6;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="440" y="350" width="330" height="260" as="geometry"/></mxCell><mxCell id="c9" value="POST /stopruntimesession&lt;br&gt;(caller's freshest bearer token)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E8;strokeColor=#ED7100;fontSize=11;fontStyle=0;dashed=0;arcSize=6;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="480" y="770" width="250" height="56" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;moca-sessions&lt;/b&gt; (DynamoDB)&lt;br&gt;one item per conversation&lt;br&gt;&lt;br&gt;activeTurnOwner — request id&lt;br&gt;activeTurnRunner — user / machine&lt;br&gt;activeTurnLeaseUntil — renewed every 60 s to +180 s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF0FC;strokeColor=#C925D1;fontSize=11;fontStyle=0;dashed=0;arcSize=6;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="1060" y="145" width="320" height="380" as="geometry"/></mxCell><mxCell id="c11" value="&amp;lt;id&amp;gt;u" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#147EBA;fontColor=#147EBA;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c7"><mxGeometry x="-0.2" relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell><mxCell id="c12" value="&amp;lt;id&amp;gt;m" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#ED7100;fontColor=#ED7100;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2692;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c8"><mxGeometry x="-0.2" relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="c13" value="&amp;lt;id&amp;gt;m" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#ED7100;fontColor=#ED7100;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7308;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c8"><mxGeometry x="-0.2" relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="c14" value="turn lock&lt;br&gt;acquire / renew / release" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#C925D1;fontColor=#C925D1;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.1184;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c10"><mxGeometry x="0.31" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="turn lock&lt;br&gt;acquire / renew / release" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#C925D1;fontColor=#C925D1;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8816;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c10"><mxGeometry x="0.31" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="after the response" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#ED7100;fontColor=#ED7100;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"><mxPoint x="70" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="c17" value="&lt;b&gt;Why:&lt;/b&gt; on V2 a runtime session is pinned to the first caller's sub, and the pin outlives Stop and the idle timeout. Other identities get the platform's 403 AccessDeniedException.&lt;br&gt;&lt;b&gt;&amp;lt;id&amp;gt;&lt;/b&gt; conversation id (33 chars) — Memory, S3 workspace, Code Interpreter and the sessions item always use it. Nobody sends it to the Runtime any more: before the split it may have been pinned to either side.&lt;br&gt;&lt;b&gt;&amp;lt;id&amp;gt;u&lt;/b&gt; humans, &lt;b&gt;&amp;lt;id&amp;gt;m&lt;/b&gt; machine callers — every conversation, old or new.&lt;br&gt;A second turn on the same conversation, from either microVM, gets serverTurnInProgressEvent." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="1340" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
