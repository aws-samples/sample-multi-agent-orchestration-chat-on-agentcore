<mxfile host="drawio" type="device"><diagram id="d1" name="Timeouts"><mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1120" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;run_workflow&lt;/b&gt; — why Lambda's 15-minute limit does not bound a workflow" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Durable execution&lt;/b&gt;&lt;br&gt;executionTimeout = 7 days" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="114" width="200" height="44" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Step turns (row A)&lt;/b&gt;&lt;br&gt;AgentCore Runtime&lt;br&gt;≤ 8 h each" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="234" width="200" height="64" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Lambda invocations&lt;/b&gt;&lt;br&gt;timeout 5 min (max 15)&lt;br&gt;each lasts seconds" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="364" width="200" height="64" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Step turns (row B)&lt;/b&gt;&lt;br&gt;AgentCore Runtime" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="504" width="200" height="44" as="geometry"/></mxCell><mxCell id="c7" value="Execution wf-… — state lives in durable checkpoints, not in a running Lambda" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F2FF;strokeColor=#8C4FFF;fontSize=11;fontStyle=0;dashed=0;