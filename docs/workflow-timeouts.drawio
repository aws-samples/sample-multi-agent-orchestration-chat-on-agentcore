step state (DynamoDB),&lt;br&gt;mint tokens (Cognito)&lt;br&gt;&lt;br&gt;&lt;i&gt;~1 s&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E8;strokeColor=#ED7100;fontSize=11;fontStyle=0;dashed=0;arcSize=6;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="620" y="700" width="270" height="110" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;3. Start step turns&lt;/b&gt;&lt;br&gt;POST /invocations:&lt;br&gt;headers ≤ 120 s + first line ≤ 20 s&lt;br&gt;parallel steps wait concurrently&lt;br&gt;&lt;i&gt;≤ ~140 s&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E8;strokeColor=#ED7100;fontSize=11;fontStyle=0;dashed=0;arcSize=6;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="960" y="700" width="270" height="110" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;4. Suspend&lt;/b&gt;&lt;br&gt;waitForCallback has no result:&lt;br&gt;return PENDING,&lt;br&gt;invocation ends&lt;br&gt;&lt;i&gt;~0 s&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E8;strokeColor=#ED7100;fontSize=11;fontStyle=0;dashed=0;arcSize=6;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1300" y="700" width="270" height="110" as="geometry"/></mxCell><mxCell id="c32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#ED7100;fontColor=#ED7100;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c28" target="c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#ED7100;fontColor=#ED7100;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c29" target="c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#ED7100;fontColor=#ED7100;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c30" target="c31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="&lt;b&gt;Worst case ≈ 140 s per invocation&lt;/b&gt; &amp;lt; Lambda timeout 300 s &amp;lt; Lambda maximum 900 s (15 min).&amp;nbsp; The hours are spent in step turns on AgentCore Runtime (≤ 8 h each) and in suspension (≤ 7 days in total), neither of which is a running Lambda." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2FAF8;strokeColor=#01A88D;fontSize=11;fontStyle=0;dashed=0;arcSize=6;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="280" y="840" width="1290" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
